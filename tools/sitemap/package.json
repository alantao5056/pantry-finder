{
  "name": "@pantry-finder/sitemap",
  "version": "1.0.0",
  "description": "Generates sitemap.xml for pantryfinder.org from Firestore",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:dev": "npm --prefix ../../packages/shared run build && tsx --env-file=.env.dev generate-sitemap.ts",
    "generate:prod": "npm --prefix ../../packages/shared run build && tsx --env-file=.env.prod generate-sitemap.ts"
  },
  "dependencies": {
    "@pantry-finder/shared": "*",
    "dotenv": "^17.4.2",
    "firebase-admin": "^13.8.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
