# Config for the sitemap generator (tools/sitemap/generate-sitemap.ts).
# Copy to .env and fill in. .env is git-ignored.

# Credentials — provide ONE of these (or pass a JSON path as the first CLI arg):
#   Path to a Firebase service-account JSON with read access to prod Firestore.
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
#   ...or base64-encoded service-account JSON (use tools/json-to-base64.js).
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Origin used to build absolute URLs. Defaults to https://pantryfinder.org.
# SITE_URL=https://pantryfinder.org

# Output path for the generated sitemap. Defaults to tools/sitemap/sitemap.xml.
# SITEMAP_OUT=./sitemap.xml
