# Config for the Firestore backup/import tool (tools/backup).
# Copy to .env.dev01 / .env.dev02 / .env.prod (one per environment) and fill in.
# All of them are git-ignored; only this example file is committed.

# Credentials — provide ONE of these:
#   Path to a Firebase service-account JSON. Backup needs read access to all
#   collections; import additionally needs write (and delete, for --replace).
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
#   ...or base64-encoded service-account JSON (use tools/json-to-base64.js).
# FIREBASE_SERVICE_ACCOUNT_JSON=
