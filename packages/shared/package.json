{
  "name": "@pantry-finder/shared",
  "version": "1.0.0",
  "description": "Shared types and utilities for Pantry Finder",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./logging": {
      "types": "./dist/logging.d.ts",
      "import": "./dist/logging.js",
      "require": "./dist/cjs/logging.js"
    },
    "./firestore": {
      "types": "./dist/firestore/index.d.ts",
      "import": "./dist/firestore/index.js",
      "require": "./dist/cjs/firestore/index.js"
    }
  },
  "typesVersions": {
    "*": {
      "logging": [
        "dist/logging.d.ts"
      ],
      "firestore": [
        "dist/firestore/index.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json && node scripts/write-cjs-pkg.mjs"
  },
  "dependencies": {
    "@google-cloud/logging": "^11.2.0"
  },
  "peerDependencies": {
    "firebase-admin": "^13.8.0"
  },
  "peerDependenciesMeta": {
    "firebase-admin": {
      "optional": true
    }
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "firebase-admin": "^13.8.0"
  }
}
